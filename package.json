{
  "name": "wurm-iso",
  "private": true,
  "version": "0.1.0",
  "description": "A browser remake of Wurm Online as a 2.5D isometric game. Full-page canvas with HTML UI overlays.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && node scripts/copy-site.mjs && node scripts/bundle-sql.mjs && node scripts/emit-wildermon.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "defs": "node scripts/emit-defs.mjs",
    "wildermon": "node scripts/emit-wildermon.mjs",
    "db:test": "supabase/test/run.sh",
    "db:bundle": "node scripts/bundle-sql.mjs",
    "views": "node tools/views.mjs > src/render/view.ts",
    "atlas": "npx esbuild tools/build-atlas.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/build-atlas.mjs --log-level=error && node --max-old-space-size=4096 node_modules/.cache/build-atlas.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0"
  }
}
