{
  "name": "wurm-iso",
  "private": true,
  "version": "0.1.0",
  "description": "A browser remake of Wurm Online as a 2.5D isometric game. Full-page canvas with HTML UI overlays.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-site.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "defs": "esbuild scripts/dump-defs.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/dump-defs.mjs --log-level=error && node node_modules/.cache/dump-defs.mjs > supabase/migrations/20260914180300_defs.sql",
    "db:test": "supabase/test/run.sh",
    "db:bundle": "node scripts/bundle-sql.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^6.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0"
  }
}
